# 现有数据库配置继续保存在 server/.env，不要用示例覆盖已有值。
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=rentverity
JWT_SECRET=

# 本地前端来源，逗号分隔；必须与浏览器地址栏的协议、主机和端口完全一致。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 将下面配置填写到被 Git 忽略的 server/.env.local，仅使用 RentVerity 独立的 Key。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=60000
