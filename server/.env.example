# 现有数据库配置继续保存在 server/.env，不要用示例覆盖已有值。
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=rentverity
JWT_SECRET=

# 本地前端来源，逗号分隔；必须与浏览器地址栏的协议、主机和端口完全一致。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 将下面配置填写到被 Git 忽略的 server/.env.local，仅使用 RentVerity 独立的 Key。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=60000

# 合同：必须同时满足文件、页数、文本、块和调用预算；字符不是精确token。
CONTRACT_MAX_BYTES=104857600
CONTRACT_MAX_PAGES=300
CONTRACT_MAX_CHARACTERS=600000
CONTRACT_PARSER_OUTPUT_BYTES=12582912
CONTRACT_PARSER_TIMEOUT_MS=90000
CONTRACT_PARSER_HEAP_MB=384
CONTRACT_PARSER_CONCURRENCY=2
CONTRACT_UPLOAD_TIMEOUT_MS=180000
CONTRACT_TASK_TIMEOUT_MS=720000
CONTRACT_TTL_MS=900000
CONTRACT_TEMP_QUOTA_BYTES=536870912
CONTRACT_DISK_MARGIN_BYTES=268435456
# 默认server/.private/contracts-v1；覆盖时用私有绝对目录，不得放入uploads。
# CONTRACT_TEMP_ROOT=
CONTRACT_CHUNK_CHARACTERS=10000
CONTRACT_OVERLAP_CHARACTERS=500
CONTRACT_SHARED_CHARACTERS=1200
CONTRACT_INPUT_CHARACTERS=16000
CONTRACT_OUTPUT_TOKENS=3600
CONTRACT_MAX_CHUNKS=64
CONTRACT_MAX_MODEL_CALLS=96
CONTRACT_BLOCK_CONCURRENCY=2
CONTRACT_BLOCK_RETRIES=1
