{
  "name": "rentverity-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/contracts.test.js dist/tests/model.test.js dist/tests/chatModel.test.js dist/tests/houseSearch.test.js dist/tests/assistant.test.js dist/tests/business.test.js",
    "db:init": "npm run build && node dist/scripts/database.js init",
    "db:seed": "npm run build && node dist/scripts/database.js seed",
    "db:upgrade-search": "npm run build && node dist/scripts/upgradeSearch.js",
    "smoke:business": "npm run build && node dist/scripts/businessSmoke.js",
    "smoke:contract": "npm run build && node dist/scripts/contractSmoke.js",
    "smoke:assistant": "npm run build && node dist/scripts/assistantSmoke.js",
    "start": "node dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "element-china-area-data": "^6.1.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.19.1",
    "pdfjs-dist": "^6.4.299",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.4.0",
    "@types/ws": "^8.5.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
